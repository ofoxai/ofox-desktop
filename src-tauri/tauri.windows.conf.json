{
  "$schema": "https://schema.tauri.app/config/2",
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Ofox Desktop",
        "titleBarStyle": "Visible",
        "hiddenTitle": false,
        "trafficLightPosition": {
          "x": 14,
          "y": 17
        },
        "width": 1000,
        "height": 650,
        "minWidth": 900,
        "minHeight": 600,
        "visible": false,
        "resizable": true,
        "fullscreen": false,
        "center": true
      }
