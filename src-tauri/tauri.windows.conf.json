{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Ofox Desktop",
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Ofox Desktop",
        "titleBarStyle": "Visible",
        "visible": false,
        "minWidth": 900,
        "minHeight": 600
      }
    ]
  },
  "bundle": {
    "targets": ["msi"],
    "icon": ["icons/icon.ico"],
    "windows": {
      "allowDowngrades": false,
      "digestAlgorithm": "sha256"
    }
  }
}
