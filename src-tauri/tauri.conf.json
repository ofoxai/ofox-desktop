{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Ofox Desktop",
  "version": "1.3.6",
  "identifier": "ai.ofox.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:3011",
    "beforeDevCommand": "pnpm run dev:renderer",
    "beforeBuildCommand": "pnpm run build:renderer"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "",
        "titleBarStyle": "Overlay",
        "trafficLightPosition": {
          "x": 14,
          "y": 17
        },
        "width": 1000,
        "height": 650,
        "minWidth": 900,
        "minHeight": 600,
        "visible": false,
        "resizable": true,
        "fullscreen": false,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: https: http:; script-src 'self'; style-src 'self' 'unsafe-inline'; connect-src 'self' ipc: http://ipc.localhost https: http:",
      "assetProtocol": {
        "enable": true,
        "scope": []
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": false,
    "resources": [
      "../scripts/installer/**/*",
      "../src/assets/agent-logos/LICENSE-*.txt",
      "../src/assets/agent-logos/LICENSE-*.md",
      "../src/assets/agent-logos/NOTICE.md",
      "../src/assets/library-logos/NOTICE.md",
      "src/services/MAGPIE_LICENSE",
      "src/session_manager/MAGPIE_LICENSE"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "wix": {
        "template": "wix/per-user-main.wxs"
      }
    },
    "macOS": {
      "minimumSystemVersion": "12.0"
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["ofoxdesktop", "ofoxswitch", "ccswitch"]
      }
    }
  }
}
