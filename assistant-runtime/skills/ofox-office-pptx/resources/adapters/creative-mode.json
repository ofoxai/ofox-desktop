  "recipe": {
    "composition": "Cream paper pages with a heavy uppercase grotesque title at left over a dotted rule; the cover and chapter pair the title with a large outlined green field holding pink, orange and yellow shapes; the closing page turns fully green with a tilted pink badge.",
    "components": "Flat saturated blocks in green, pink, yellow and orange with 1.5pt black outlines for figures and steps, cream outlined boxes for plain cards, yellow for the highlighted box. Square corners, no gradients or soft shadows.",
    "narrative": "Title, chapter opener, figures, system, chart, process, options compared, sign-off.",
    "nativeCoverage": "Cover, chapter, figure blocks, bar chart, four-block process, table and green closing as native shapes, text, chart and table. Two-colour title lines, the staggered layer stack, per-bar colours, colour-filled table columns, mono labels and pills, and Archivo Black / Space Grotesk are not reproduced."
  },
  "pageMapping": [
    {
      "page": 1,
      "archetype": "cover",
      "native": "cover_slide",
      "status": "adapted",
      "differences": "Source sets the second title line in orange; the native title is one colour."
    },
    {
      "page": 2,
      "archetype": "chapter",
      "native": "section_slide",
      "status": "approximate",
      "differences": "Source adds a three-paragraph text column between the title and the green square; the native chapter page keeps the title, tag, pink bar and square only."
    },
    {
      "page": 3,
      "archetype": "stats",
      "native": "content_slide + kpi",
      "status": "adapted",
      "differences": "Source arranges four tiles two by two with one cream outlined tile; the sample shows three colour tiles in a row."
    },
    {
      "page": 4,
      "archetype": "hierarchy",
      "native": "content_slide + pyramid",
      "status": "approximate",
      "differences": "Source staggers four colour layers with hard shadows inside a green field beside a text column and legend; native is a centred stack of bars with one accent level."
    },
    {
      "page": 5,
      "archetype": "chart-bar",
      "native": "content_slide + native_chart",
      "status": "approximate",
      "differences": "Source colours bars by series in turn with black outlines and value labels; the native single-series chart is one colour without outlines."
    },
    {
      "page": 6,
      "archetype": "process",
      "native": "content_slide + steps",
      "status": "adapted",
      "differences": "First block is green rather than cream outlined; the small triangles between blocks are omitted."
    },
    {
      "page": 7,
      "archetype": "table",
      "native": "content_slide + table",
      "status": "approximate",
      "differences": "Source fills each option column with its own colour and adds a tilted yellow tag; the native table has a black header and plain cream rows."
    },
    {
      "page": 8,
      "archetype": "closing",
      "native": "closing_slide",
      "status": "adapted",
      "differences": "Badge is drawn without its counter text."
    }
  ]
