  "recipe": {
    "composition": "One near-black navy canvas throughout; heavy off-white sans titles at the left, the cover title low on the page in warm orange under a dim node-and-edge network, the closing word centred in green. A three-node motif marks the top right of other pages.",
    "components": "Dark navy cards with a hairline border, big warm-orange numerals for stats, numbered dark step cards, a darker code panel with mono text. Accent colours (warm, blue, green, rose, purple) appear one at a time.",
    "narrative": "Hook, why graphs, what the tool does, one command, with versus without, pipeline, try it, thanks.",
    "nativeCoverage": "Cover, chapter, card row, code panel, stat cards, step cards and closing as native text and shapes. Not reproduced: gradient-filled title words (drawn in one flat colour), glowing nodes and text glow, card gradients, emoji icons, the race-bar comparison, hashtag chips, Inter and JetBrains Mono."
  },
  "pageMapping": [
    {
      "page": 1,
      "archetype": "cover",
      "native": "cover_slide",
      "status": "approximate",
      "differences": "The orange-to-green-to-blue gradient title is drawn in one flat warm orange; network nodes have no glow."
    },
    {
      "page": 2,
      "archetype": "chapter",
      "native": "section_slide",
      "status": "adapted",
      "differences": "The rose-to-purple gradient on the second title word is not reproduced; the title is one off-white colour."
    },
    {
      "page": 3,
      "archetype": "cards",
      "native": "content_slide + card",
      "status": "approximate",
      "differences": "Four emoji-headed feature cards and a full-width note bar become a row of three text cards without icons or the note bar."
    },
    {
      "page": 4,
      "archetype": "code",
      "native": "content_slide + code",
      "status": "approximate",
      "differences": "The large glowing green command line above the code box is not drawn; code has no syntax colouring."
    },
    {
      "page": 5,
      "archetype": "stats",
      "native": "content_slide + kpi",
      "status": "approximate",
      "differences": "Two emoji race bars above the stat cards are not reproduced; stat numerals are flat warm orange instead of a gradient."
    },
    {
      "page": 6,
      "archetype": "process",
      "native": "content_slide + steps",
      "status": "approximate",
      "differences": "Emoji icons, the arrows between the cards and the note bar below are not drawn; steps are numbered instead."
    },
    {
      "page": 7,
      "archetype": "code",
      "native": "content_slide + code",
      "status": "approximate",
      "differences": "Source shows two bare glowing command lines and a row of hashtag chips under a gradient title; native puts the commands in one code panel without chips."
    },
    {
      "page": 8,
      "archetype": "closing",
      "native": "closing_slide",
      "status": "approximate",
      "differences": "The yellow-to-green gradient on the closing word is drawn in one flat green."
    }
  ]
