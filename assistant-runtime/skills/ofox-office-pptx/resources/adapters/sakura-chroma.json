  "recipe": {
    "composition": "Warm cream paper with dark-brown type; the cover sets a huge product-code title beside a diagonal five-colour ribbon band, a cluster of overlapping circles and a pink label block; statements are centred between scattered colour dots; content pages carry a plain title over one hairline rule; the closing runs the ribbons across the page.",
    "components": "Thin-outlined columns under a thick red top bar, bare oversized red numerals, flat adjoining label blocks in red, orange, yellow, green and blue. Flat colour only: no gradients, shadows or rounded cards.",
    "narrative": "Cover, short letter, catalogue, founder note, output by year, reader quote, release schedule, colophon.",
    "nativeCoverage": "Cover with ribbons and circles, centred statement, catalogue columns, bar chart, table and ribbon closing as native shapes, text, chart and table. The boxed note over full-page ribbons, the unit-block grid chart, per-column bar colours, checkbox and tag columns, the starburst badge, kanji micro-type and Big Shoulders Display are not reproduced."
  },
  "pageMapping": [
    {
      "page": 1,
      "archetype": "cover",
      "native": "cover_slide",
      "status": "adapted",
      "differences": "Ribbon band ends are square-cut rather than a clipped parallelogram; the checkbox spec list and starburst badge are omitted."
    },
    {
      "page": 2,
      "archetype": "statement",
      "native": "statement_slide",
      "status": "adapted",
      "differences": ""
    },
    {
      "page": 3,
      "archetype": "cards",
      "native": "content_slide + card",
      "status": "approximate",
      "differences": "Source gives each of the four columns its own bar colour and a spec table at the foot; native cards share one red bar and hold title and body only."
    },
    {
      "page": 4,
      "archetype": "statement",
      "native": "statement_slide",
      "status": "approximate",
      "differences": "Source sets the note in a bordered paper box over full-page diagonal ribbons; the native statement is centred text between scattered dots, without ribbons or box."
    },
    {
      "page": 5,
      "archetype": "chart-bar",
      "native": "content_slide + native_chart",
      "status": "approximate",
      "differences": "Source is a stacked unit-block grid in six colours with two large figures at its left; native is a plain column chart."
    },
    {
      "page": 6,
      "archetype": "quote",
      "native": "statement_slide",
      "status": "approximate",
      "differences": "Source quote is left-aligned under a circle cluster with a ruled attribution line; native centres the quote between scattered dots."
    },
    {
      "page": 7,
      "archetype": "table",
      "native": "content_slide + table",
      "status": "approximate",
      "differences": "Source rows are open lines with coloured track tags and checkbox columns; the native table has a filled header and plain text cells."
    },
    {
      "page": 8,
      "archetype": "closing",
      "native": "closing_slide",
      "status": "approximate",
      "differences": "Source overprints the title on the ribbon wedge and ends with three ruled meta columns and a starburst; native keeps the title above the ribbons and one meta line."
    }
  ]
}
