  "recipe": {
    "composition": "One deep blue canvas on every page. Serif titles in warm yellow are centred with generous empty space; content sits in a narrow centred column under a single hairline.",
    "components": "Bare serif numerals, open blocks under a hairline and numbered steps. Teal appears only as one small mark. No bright accent colours, no card grids.",
    "narrative": "Title, one claim, supporting text, three findings, rules, a quotation, before/after, one chart, sign-off.",
    "nativeCoverage": "Cover, statement, text page, stat row, list, quotation, two-panel comparison, bar chart and closing as native text, shapes and chart; Cormorant Garamond, the teal quotation glyph, centred stat columns and the full-bleed two-tone split are not reproduced."
  },
  "pageMapping": [
    {
      "page": 1,
      "archetype": "cover",
      "native": "cover_slide",
      "status": "adapted",
      "differences": "Title uses a bold system serif instead of regular Cormorant Garamond."
    },
    {
      "page": 2,
      "archetype": "statement",
      "native": "statement_slide",
      "status": "adapted",
      "differences": ""
    },
    {
      "page": 3,
      "archetype": "chapter",
      "native": "section_slide",
      "status": "approximate",
      "differences": "Source is a text page: a centred heading over a short paragraph. The native page carries the paragraph as a one-line subtitle and adds a small section number."
    },
    {
      "page": 4,
      "archetype": "stats",
      "native": "content_slide + kpi",
      "status": "approximate",
      "differences": "Source centres each numeral in its column with vertical hairline dividers; native numerals are left-aligned in their columns with no dividers."
    },
    {
      "page": 5,
      "archetype": "list",
      "native": "content_slide + bullets",
      "status": "adapted",
      "differences": "Source centres the heading and list vertically; the native heading stays at the top."
    },
    {
      "page": 6,
      "archetype": "quote",
      "native": "statement_slide",
      "status": "adapted",
      "differences": "The teal quotation glyph becomes a short teal rule."
    },
    {
      "page": 7,
      "archetype": "comparison",
      "native": "content_slide + card",
      "status": "approximate",
      "differences": "Source splits the whole page into a darker and a lighter half with no title; native keeps a page title above two open columns under hairlines."
    },
    {
      "page": 8,
      "archetype": "chart-bar",
      "native": "content_slide + native_chart",
      "status": "adapted",
      "differences": "Native chart with editable data; the highlighted last bar is not styled separately."
    },
    {
      "page": 9,
      "archetype": "closing",
      "native": "closing_slide",
      "status": "adapted",
      "differences": ""
    }
  ]
