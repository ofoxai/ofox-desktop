  "recipe": {
    "composition": "Three flat canvases take turns: forest green for openers, data and the close, dusty pink for the one big statement, cream for working pages. Serif headlines set top-left; pink display type on green.",
    "components": "Flat colour blocks in green, pink and cream for agenda items, steps and comparisons; bare serif numerals in pink on green; pink-and-cream charts on green. No outlines-only card grids, no gradients, no fourth colour.",
    "narrative": "Cover, agenda, the shift, a two-column proof with image, numbers by period, a plan in steps, three figures, summary.",
    "nativeCoverage": "Cover, agenda blocks, statement, split text with image region, bar chart, colour-block steps, stat row and closing as native text, shapes and chart; Source Serif 4 and the mono labels, the bento agenda grid, the full-height image panel, the rule above the stat row and the three-column summary are not reproduced."
  },
  "pageMapping": [
    { "page": 1, "archetype": "cover", "native": "cover_slide", "status": "adapted", "differences": "The ring at the top right is empty; the source puts the page number in it." },
    { "page": 2, "archetype": "agenda", "native": "content_slide + steps", "status": "approximate", "differences": "Source is a bento grid with one tall block and four smaller ones; native shows the items as one row of equal colour blocks." },
    { "page": 3, "archetype": "statement", "native": "statement_slide", "status": "adapted", "differences": "" },
    { "page": 4, "archetype": "split-image", "native": "content_slide + bullets + image", "status": "approximate", "differences": "Source fills the left half with a full-height green image panel and sets heading, paragraphs and a three-field footer on the right; native keeps the heading at the top with bullets left and the image region right." },
    { "page": 5, "archetype": "chart-bar", "native": "content_slide + native_chart", "status": "adapted", "differences": "Native chart with editable data; the source legend sits at the top right." },
    { "page": 6, "archetype": "process", "native": "content_slide + steps", "status": "adapted", "differences": "Source blocks are outlined cream, pink, green, outlined cream with a ruled footer line each; native blocks take the palette colours in order and have no footer line." },
    { "page": 7, "archetype": "stats", "native": "content_slide + kpi", "status": "adapted", "differences": "Source draws one hairline above the row of numerals; native numerals stand bare." },
    { "page": 8, "archetype": "closing", "native": "closing_slide", "status": "approximate", "differences": "Source lists three numbered takeaways in columns under the rule; native has one subtitle line and one meta line." }
  ]
