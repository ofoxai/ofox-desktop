  "recipe": {
    "composition": "Cream paper and one cobalt blue for everything. Large serif headlines set top-left between a head and a foot hairline; openers and quotations carry a stair-stepped block of vertical cobalt stripes at one side.",
    "components": "Hairline-topped open entries, bare serif numerals, numbered steps and cobalt-tint charts. Never a second colour, a filled card grid or a rounded shape.",
    "narrative": "Issue cover, editor's statement, index of entries, chapter opener, one data page, a quotation, a ledger table, colophon.",
    "nativeCoverage": "Cover, statement, numbered index, chapter, bar chart, quotation, table and closing as native text, hairlines, stripe shapes, chart and table; Newsreader type, the graph-paper grid, the vertical side caption, the stacked-cell chart, the QR-style block and the four-column colophon are not reproduced."
  },
  "pageMapping": [
    {
      "page": 1,
      "archetype": "cover",
      "native": "cover_slide",
      "status": "adapted",
      "differences": "The graph-paper grid and the vertical side caption are not drawn; the stripe ornament is a simplified silhouette."
    },
    {
      "page": 2,
      "archetype": "statement",
      "native": "statement_slide",
      "status": "adapted",
      "differences": "Source page has no stripe ornament; native statements carry a narrow stripe column at the right edge."
    },
    {
      "page": 3,
      "archetype": "agenda",
      "native": "content_slide + steps",
      "status": "approximate",
      "differences": "Source lists six numbered entries in two columns of ruled rows; native shows one row of numbered steps."
    },
    {
      "page": 4,
      "archetype": "chapter",
      "native": "section_slide",
      "status": "adapted",
      "differences": ""
    },
    {
      "page": 5,
      "archetype": "chart-bar",
      "native": "content_slide + kpi + native_chart",
      "status": "approximate",
      "differences": "Source pairs two large numerals with a chart built from stacked square cells; the native sample is a plain bar chart without the numerals or the cell grid."
    },
    {
      "page": 6,
      "archetype": "quote",
      "native": "statement_slide",
      "status": "adapted",
      "differences": ""
    },
    {
      "page": 7,
      "archetype": "table",
      "native": "content_slide + table",
      "status": "approximate",
      "differences": "Source ledger is open rows separated by hairlines with mono column labels; the native table has a filled cobalt header row and tinted alternate rows."
    },
    {
      "page": 8,
      "archetype": "closing",
      "native": "closing_slide",
      "status": "approximate",
      "differences": "Source colophon has four small columns and a QR-style block; native has one subtitle and one meta line."
    }
  ]
}
