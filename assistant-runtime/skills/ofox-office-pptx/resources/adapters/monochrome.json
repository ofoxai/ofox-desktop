      "status": "adapted",
      "differences": ""
    },
    {
      "page": 4,
      "archetype": "split-image",
      "native": "content_slide + bullets + image",
      "status": "approximate",
      "differences": "Source sets the heading and a paragraph beside the image; native keeps the heading at the top, and the image region is filled only by a planned asset."
    },
    {
      "page": 5,
      "archetype": "stats",
      "native": "content_slide + kpi",
      "status": "adapted",
      "differences": "Source draws one rule above the row of numerals; native draws a rule under each numeral block."
    },
    {
      "page": 6,
      "archetype": "list",
      "native": "content_slide + bullets",
      "status": "approximate",
      "differences": "Source places the heading in a left column beside the list with dash markers; native puts the heading above a bulleted list."
    },
    {
      "page": 7,
      "archetype": "comparison",
      "native": "content_slide + card",
      "status": "approximate",
      "differences": "Source has no page heading and a vertical hairline between the two columns; native adds a heading and draws only the hairline above each column."
    },
    {
      "page": 8,
      "archetype": "quote",
      "native": "statement_slide",
      "status": "approximate",
      "differences": "Source sets the quotation in Lora serif without rules; native uses the sans heading font between the head and foot rules."
    },
    {
      "page": 9,
      "archetype": "cards",
      "native": "content_slide + card",
      "status": "approximate",
      "differences": "Source is two columns of running paragraphs under mono labels; native shows short hairline-topped blocks, three across in the sample."
    },
    {
      "page": 10,
      "archetype": "chart-bar",
      "native": "content_slide + native_chart",
      "status": "adapted",
      "differences": "Native chart with editable data; the black highlighted last bar is not styled separately."
    },
    {
      "page": 11,
      "archetype": "process",
      "native": "content_slide + steps",
      "status": "adapted",
      "differences": "Source numerals are light grey; native numerals are black."
    },
    {
      "page": 12,
      "archetype": "chart-pie",
      "native": "content_slide + native_chart",
      "status": "approximate",
      "differences": "Source is a donut ring beside a ruled percentage list; native is a pie chart with its own legend."
    },
    {
      "page": 13,
      "archetype": "timeline",
      "native": "content_slide + timeline",
      "status": "approximate",
      "differences": "Source timeline runs down the page with week labels in the left margin; native timeline runs left to right."
    },
    {
      "page": 14,
      "archetype": "cycle",
      "native": "content_slide + relation + callout",
      "status": "approximate",
      "differences": "Source arranges four steps in a 2×2 grid with arrows around the loop; native shows one row of four boxes and a note that the last step feeds the first."
    },
    {
      "page": 15,
      "archetype": "hierarchy",
      "native": "content_slide + pyramid",
      "status": "adapted",
      "differences": "Source shades the five levels from black to pale grey; native fills only the top level."
    },
    {
