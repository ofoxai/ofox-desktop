  "recipe": {
    "composition": "Ivory paper, black ink only. A hairline at the head and foot of each page, a plain sans heading set left with wide margins, and open type; nothing is filled or coloured.",
    "components": "Hairline-topped open columns, numerals over a rule, numbered steps in a row, grey-to-black charts. No filled cards, no accent colour, no rounded shapes.",
    "narrative": "Title, context, key finding, evidence, numbers, recommendations, before/after, a participant quotation, analysis, charts, method, hierarchy, next steps.",
    "nativeCoverage": "Cover, chapter, statement, split text with image region, stat row, list, comparison, quotation, text columns, bar chart, numbered method, pie chart, timeline, cycle, pyramid and closing as native text, hairline shapes, charts and table; light-weight Jost headings, the Lora serif quotation, the donut legend list, the vertical timeline and the 2×2 cycle grid are not reproduced."
  },
  "pageMapping": [
    {
      "page": 1,
      "archetype": "cover",
      "native": "cover_slide",
      "status": "adapted",
      "differences": "Heading is bold; the source sets it in a light weight."
