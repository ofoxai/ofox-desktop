  "recipe": {
    "composition": "Sticky notes on a desk: warm paper, cream and cork canvases alternate; the page title is written on a slightly tilted yellow note with a red pin, cover, quote and closing put the text on one large note with smaller notes around it.",
    "components": "Square-cornered note blocks in yellow, blue, pink and green with a soft offset shadow and dark serif text; stats and steps are notes too. One note carries one thought.",
    "narrative": "Scattered idea, problem and answer, growth chart, three moves, phases, spotlight image, key statistics, before and after, thanks.",
    "nativeCoverage": "Cover, quote, note cards, comparison, bar and pie charts, numbered note steps, text with image region and closing as native text, shapes and charts. Not reproduced: tilted content notes (only decorative notes are rotated), tape strips, handwritten Caveat labels on the small notes, Shrikhand and Zilla Slab type, soft blurred drop shadows, paper grid and doodle textures, dashed curved arrows."
  },
  "pageMapping": [
    {
      "page": 1,
      "archetype": "cover",
      "native": "cover_slide",
      "status": "adapted",
      "differences": "Small notes carry no handwritten labels; the source's paragraph under the note becomes one meta line."
    },
    {
      "page": 2,
      "archetype": "quote",
      "native": "statement_slide",
      "status": "adapted",
      "differences": "Tape strip and the handwritten line on the small blue note are not drawn."
    },
    {
      "page": 3,
      "archetype": "comparison",
      "native": "content_slide + card",
      "status": "approximate",
      "differences": "Two tilted checklist notes with numbered section headings become two upright note cards with bullets under a title note; check marks become bullets."
    },
    {
      "page": 4,
      "archetype": "chart-bar",
      "native": "content_slide + native_chart",
      "status": "approximate",
      "differences": "Source chart is hand-outlined on a taped white sheet beside a green key-metrics note; native is an editable chart on the canvas without the side note."
    },
    {
      "page": 5,
      "archetype": "cards",
      "native": "content_slide + card",
      "status": "adapted",
      "differences": "Notes are upright; pins and the circled letters A, B, C are not drawn."
    },
    {
      "page": 6,
      "archetype": "process",
      "native": "content_slide + steps",
      "status": "approximate",
      "differences": "Three note-and-description pairs in a zigzag joined by dashed arrows become one row of numbered note blocks."
    },
    {
      "page": 7,
      "archetype": "split-image",
      "native": "content_slide + bullets + image",
      "status": "approximate",
      "differences": "Source has a taped photo frame on the left and the text on a pink note with a yellow caption strip; native puts open bullets on the left and a flat image region on the right."
    },
    {
      "page": 8,
      "archetype": "chart-pie",
      "native": "content_slide + native_chart",
      "status": "approximate",
      "differences": "The yellow key-statistics note beside the chart and the taped white sheet are not reproduced; native is a pie chart on the canvas."
    },
    {
      "page": 9,
      "archetype": "comparison",
      "native": "content_slide + card",
      "status": "adapted",
      "differences": "The round vs badge between the notes, the heading underlines and the tilt are not drawn."
    },
    {
      "page": 10,
      "archetype": "closing",
      "native": "closing_slide",
      "status": "adapted",
      "differences": "Small notes carry no handwritten labels."
    }
  ]
}
