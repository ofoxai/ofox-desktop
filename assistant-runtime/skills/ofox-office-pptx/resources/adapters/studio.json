    { "page": 6, "archetype": "list", "native": "content_slide + bullets", "status": "adapted", "differences": "Two-column title/list offset is approximated by regions." },
    { "page": 7, "archetype": "quote", "native": "statement_slide", "status": "adapted", "differences": "" },
