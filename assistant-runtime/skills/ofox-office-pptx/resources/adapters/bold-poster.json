  "recipe": {
    "composition": "White pages with a very large serif title pinned top-left on the cover; quotations fill the page in red with centred white type, chapter openers and an occasional content page turn near-black. A red rule runs along the bottom edge.",
    "components": "Red serif numerals in dark ruled boxes, text blocks behind a red rule at the left, red numbered columns. A few large statements per page, never paragraphs or soft card grids.",
    "narrative": "Poster cover, a quotation, summary with figures, performance figures, one hero number, service lines, roadmap, pillars, presence, thank you.",
    "nativeCoverage": "Cover, red quotation, ruled stat boxes, red-ruled blocks, a dark roadmap page, numbered pillars and closing as native text and shapes; Shrikhand and Libre Baskerville, the two-colour cover title, the tilted closing title, joined stat grids, the single hero numeral and the 2×2 block layouts are not reproduced."
  },
  "pageMapping": [
    {
      "page": 1,
      "archetype": "cover",
      "native": "cover_slide",
      "status": "approximate",
      "differences": "Source title mixes a black line, a red line and a smaller word in one block; the native title is one colour and one size."
    },
    {
      "page": 2,
      "archetype": "quote",
      "native": "statement_slide",
      "status": "adapted",
      "differences": ""
    },
    {
      "page": 3,
      "archetype": "stats",
      "native": "content_slide + text + kpi",
      "status": "approximate",
      "differences": "Source sets two columns of paragraphs above three figures that share one ruled box; the native sample shows only the row of figures, each in its own ruled box."
    },
    {
      "page": 4,
      "archetype": "stats",
      "native": "content_slide + kpi",
      "status": "approximate",
      "differences": "Source is a joined 3×2 ruled grid of six figures; native draws one row of separate ruled boxes."
    },
    {
      "page": 5,
      "archetype": "stats",
      "native": "content_slide + kpi",
      "status": "approximate",
      "differences": "Source centres a single hero numeral about four times the size of the three figures below it, with no page title; native figures are equal in size, in ruled boxes under a title."
    },
    {
      "page": 6,
      "archetype": "cards",
      "native": "content_slide + card",
      "status": "approximate",
      "differences": "Source arranges four red-ruled blocks 2×2 in a narrow centred column with bullet lists; native sets the blocks in one row across the page."
    },
    {
      "page": 7,
      "archetype": "cards",
      "native": "content_slide + card",
      "status": "approximate",
      "differences": "Source is a 2×2 roadmap of phases with red mono labels and no page title; native shows a titled row of red-ruled blocks on the same dark canvas."
    },
    {
      "page": 8,
      "archetype": "process",
      "native": "content_slide + steps",
      "status": "approximate",
      "differences": "Source pillars sit on a pale band across the page, divided by vertical rules, with no title; native shows red numbered columns under a title without the band."
    },
    {
      "page": 9,
      "archetype": "stats",
      "native": "content_slide + kpi",
      "status": "approximate",
      "differences": "Each source ruled box holds a place name, a paragraph and two small red figures, 2×2; a native ruled box holds one figure, its label and a note, in one row."
    },
    {
      "page": 10,
      "archetype": "closing",
      "native": "closing_slide",
      "status": "approximate",
      "differences": "Source title is tilted and followed by three underlined links; the native title is level and the links become one meta line."
    }
  ]
