  "recipe": {
    "composition": "Clean near-white dashboard canvas; a small blue square and short blue rule sit above a bold navy title at the top left; content follows on one grid. The cover puts the period in a white chip at the top right; the closing is centred.",
    "components": "White tiles with a hairline border and a blue bar on the left edge for KPIs, blockers and steps; values in bold navy; editable tables for owner lists; blue-first chart colours. No decoration beyond the mark and rule.",
    "narrative": "Headline of the week, KPIs, shipped, metric deep-dive, blockers, next week, thanks.",
    "nativeCoverage": "Cover, KPI tiles, list, bar chart, blocker cards, owner table and closing as native text, shapes, chart and table. Not reproduced: per-status bar colours (green, amber, red), delta chips inside tiles, tag chips and owner handles on list rows, the accent-coloured number inside the cover title, the gradient chart bars, emoji, Inter and JetBrains Mono."
  },
  "pageMapping": [
    {
      "page": 1,
      "archetype": "cover",
      "native": "cover_slide",
      "status": "adapted",
      "differences": "The blue-coloured figure inside the title is not coloured separately; the brand name next to the blue square is not drawn."
    },
    {
      "page": 2,
      "archetype": "stats",
      "native": "content_slide + kpi",
      "status": "approximate",
      "differences": "Eight tiles in two rows with green, blue, amber and red bars and delta chips become one row of three tiles with blue bars and a note line."
    },
    {
      "page": 3,
      "archetype": "list",
      "native": "content_slide + bullets",
      "status": "approximate",
      "differences": "Source rows have a coloured tag chip, a bold title with a description line, an owner handle and hairline separators; native is a plain bullet list."
    },
    {
      "page": 4,
      "archetype": "chart-bar",
      "native": "content_slide + native_chart",
      "status": "approximate",
      "differences": "Source chart sits in a white bordered card with its own heading, a target chip and a note line, with gradient bars; native is an editable chart on the canvas."
    },
    {
      "page": 5,
      "archetype": "cards",
      "native": "content_slide + card",
      "status": "approximate",
      "differences": "Three stacked full-width blocker cards with red left bars and mono meta lines become a row of three cards with blue left bars."
    },
    {
      "page": 6,
      "archetype": "table",
      "native": "content_slide + table",
      "status": "approximate",
      "differences": "Borderless owner rows with hairline separators become an editable table with a navy header row."
    },
    {
      "page": 7,
      "archetype": "closing",
