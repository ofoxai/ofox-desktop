      "differences": ""
    },
    {
      "page": 4,
      "archetype": "split-image",
      "native": "content_slide + bullets + image",
      "status": "approximate",
      "differences": "Image region is filled only by a planned asset; the source's slash bullet markers become standard bullets."
    },
    {
      "page": 5,
      "archetype": "stats",
      "native": "content_slide + kpi",
      "status": "approximate",
      "differences": "Source has no page title and hangs the three figures under a full-width rule at mid page; native adds a title line and places the figures in the body area."
    },
    {
      "page": 6,
      "archetype": "list",
      "native": "",
      "status": "unsupported",
      "differences": "Right-aligned stack of display words fading in opacity above a giant title; there is no native display-size fading list."
    },
    {
      "page": 7,
      "archetype": "list",
      "native": "content_slide + bullets",
      "status": "approximate",
      "differences": "Source sets the title in a left column beside the list; native stacks the title above the list."
    },
    {
      "page": 8,
      "archetype": "quote",
      "native": "statement_slide",
      "status": "approximate",
      "differences": "Source quote is cream text with an orange attribution; the native statement page sets the quote itself in orange with a muted attribution."
    },
    {
      "page": 9,
      "archetype": "comparison",
      "native": "content_slide + card",
      "status": "adapted",
      "differences": "Native adds a page title above the two panels."
    },
    {
      "page": 10,
      "archetype": "chart-bar",
      "native": "content_slide + native_chart",
      "status": "approximate",
      "differences": "Source greys every bar except an orange last bar and labels each bar; the native chart colours the whole series orange."
    },
    {
      "page": 11,
      "archetype": "process",
      "native": "content_slide + steps",
      "status": "adapted",
      "differences": ""
    },
    {
      "page": 12,
      "archetype": "chart-pie",
      "native": "content_slide + native_chart",
      "status": "approximate",
      "differences": "Source is a donut with a side legend table of percentages; native is a full pie with a bottom legend."
    },
    {
      "page": 13,
      "archetype": "hierarchy",
      "native": "content_slide + pyramid",
      "status": "approximate",
      "differences": "Source bars are left-aligned steps in graded orange; native is a centred pyramid with one orange top level."
    },
    {
      "page": 14,
      "archetype": "timeline",
      "native": "content_slide + timeline",
      "status": "approximate",
      "differences": "Source timeline runs vertically with dates in a left gutter; native runs horizontally."
    },
    {
      "page": 15,
      "archetype": "cycle",
      "native": "content_slide + relation + callout",
      "status": "approximate",
      "differences": "Source is a 2x2 grid of numbered cells with arrows looping back; native is one row of linked boxes with a callout for the return step."
    },
    {
      "page": 16,
      "archetype": "closing",
      "native": "closing_slide",
      "status": "adapted",
      "differences": ""
    }
