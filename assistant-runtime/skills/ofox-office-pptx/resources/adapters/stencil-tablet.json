  "recipe": {
    "composition": "Bone-paper pages alternate with pure black pages; large serif capitals carry the cover (bottom-left, under a teal leaf form), black chapter pages pair a giant orange numeral with a right-aligned title, quotes sit on one magenta panel and the closing splits into teal and orange panels.",
    "components": "Saturated rounded blocks in sienna, magenta, orange, teal, blue and mustard for numbered moves and figures; plain paper rounded cards with the highlighted one in orange; black-header tables. No outlines, gradients or shadows.",
    "narrative": "Title, agenda, principles, direction, findings, evidence, process, options matrix, numbers, client voice, next steps.",
    "nativeCoverage": "Cover, agenda blocks, numbered blocks, black chapter, finding cards, line chart, five-move process, table, figure blocks, quote panel and two-panel closing as native shapes, text, chart and table. Stencil-cut silhouettes, the mustard action-title band, the paper chart panel, pill tags in table cells, the numbered action list on the closing page and Bowlby One / Stardos Stencil are not reproduced."
  },
  "pageMapping": [
    {
      "page": 1,
      "archetype": "cover",
      "native": "cover_slide",
      "status": "adapted",
      "differences": "The stencil-cut leaf is drawn as two overlapping ovals."
    },
    {
      "page": 2,
      "archetype": "agenda",
      "native": "content_slide + steps",
      "status": "approximate",
      "differences": "Source items are tall stencil-cut silhouettes (hourglass, octagon, spool); native items are numbered rounded blocks under a page title."
    },
    {
      "page": 3,
      "archetype": "process",
      "native": "content_slide + steps",
      "status": "approximate",
      "differences": "Source is four full-height principle blocks with the numeral at the top and text at the foot, not a sequence; native numbered blocks are shorter and keep the text under the numeral."
    },
    {
      "page": 4,
      "archetype": "chapter",
      "native": "section_slide",
      "status": "adapted",
      "differences": ""
    },
    {
      "page": 5,
      "archetype": "cards",
      "native": "content_slide + card",
      "status": "approximate",
      "differences": "Source sets the action title in a mustard band joined to the three columns; native uses a plain page title above three separate cards."
    },
    {
      "page": 6,
      "archetype": "chart-line",
      "native": "content_slide + native_chart",
      "status": "approximate",
      "differences": "Source puts the chart in a light paper panel on the right beside a title column, with a dashed control line; native draws the chart across the black canvas."
    },
    {
      "page": 7,
      "archetype": "process",
      "native": "content_slide + steps",
      "status": "adapted",
      "differences": "Intro text beside the title and the week strip under the blocks are omitted."
    },
    {
      "page": 8,
      "archetype": "table",
      "native": "content_slide + table",
      "status": "adapted",
      "differences": "Coloured pill tags inside cells become plain cell text."
    },
    {
      "page": 9,
      "archetype": "stats",
      "native": "content_slide + kpi",
      "status": "adapted",
      "differences": "Block colours follow the palette order (sienna, magenta, orange) rather than orange, mustard, bone."
    },
    {
      "page": 10,
      "archetype": "quote",
      "native": "statement_slide",
      "status": "adapted",
      "differences": "The large quotation mark at the left of the panel is omitted."
    },
    {
      "page": 11,
      "archetype": "closing",
      "native": "closing_slide",
      "status": "approximate",
      "differences": "Source fills the orange panel with a numbered list of three next steps; the native closing page holds only a meta line there."
    }
  ]
