  "recipe": {
    "composition": "Centred didone-style serif titles on warm off-white; cover, quote, chapter and closing pages scatter outlined multicolour pills and dots around the text, content pages stay clean with one centred block.",
    "components": "Rounded white cards with a thin ink outline, outlined white stat capsules with coral serif numerals, pill-shaped palette step blocks; flat fills only, at most three or four blocks per page.",
    "narrative": "Idea, principles, indicators, quote, phased plan, key numbers, system view, vision, thanks.",
    "nativeCoverage": "Cover, chapter, three-card page, bar chart, quote, timeline, stat row, process blocks, text with image region and closing as native text, shapes and chart. Not reproduced: labels inside the scattered pills, the soft background colour blurs, highlighted words inside the quote, per-value stat colours, Bodoni Moda and Space Grotesk, navigation dots."
  },
  "pageMapping": [
    {
      "page": 1,
      "archetype": "cover",
      "native": "cover_slide",
      "status": "adapted",
      "differences": "Scattered pills carry no word labels; background colour blurs are not drawn."
    },
    {
      "page": 2,
      "archetype": "chapter",
      "native": "section_slide",
      "status": "approximate",
      "differences": "Source has two body paragraphs beside the pill cluster; the native chapter page has a title, one subtitle line and the numbered circle with unlabelled pills."
    },
    {
      "page": 3,
      "archetype": "cards",
      "native": "content_slide + card",
      "status": "adapted",
      "differences": "Roman-numeral colour badges inside the cards and the kicker pill above the title are not drawn."
    },
    {
      "page": 4,
      "archetype": "chart-bar",
      "native": "content_slide + native_chart",
      "status": "approximate",
      "differences": "Source draws five horizontal pill-shaped progress bars in different colours inside a rounded card; native is an editable column chart in one series colour without the card."
    },
    {
      "page": 5,
      "archetype": "quote",
      "native": "statement_slide",
      "status": "approximate",
      "differences": "The lime and sky pill highlights behind two phrases and the large coral quote mark are not reproduced; scattered pills carry no labels."
    },
    {
      "page": 6,
      "archetype": "timeline",
      "native": "content_slide + timeline",
      "status": "approximate",
      "differences": "Numbered outlined circles on the line become small filled dots with period labels above them."
    },
    {
      "page": 7,
      "archetype": "stats",
      "native": "content_slide + kpi",
      "status": "approximate",
      "differences": "Each source value has its own colour and a short coloured underline; native values share the coral accent and have no underline."
    },
    {
      "page": 8,
      "archetype": "process",
      "native": "content_slide + steps",
      "status": "approximate",
      "differences": "Source connects four outlined pills with a line and adds three tagged notes below; native draws numbered pill blocks in palette colours without connectors or the note row."
    },
    {
      "page": 9,
      "archetype": "split-image",
      "native": "content_slide + bullets + image",
      "status": "approximate",
      "differences": "Image sits on the left with a lavender-to-mint gradient placeholder and a tag-pill row under the text; native puts the image region on the right, flat, without tags."
    },
    {
      "page": 10,
      "archetype": "closing",
      "native": "closing_slide",
      "status": "adapted",
      "differences": "Kicker pill above the title is omitted; pills carry no labels."
    }
  ]
}
