  "recipe": {
    "composition": "Each page takes one flat pastel canvas (cream yellow, sky blue, off-white, lime, hot pink) and the closing turns black; cover, quote and closing put the text inside one centred box with a thick black border and a hard offset shadow; a small yellow tag chip sits above heavy uppercase titles.",
    "components": "White square-cornered boxes with 3pt black borders and hard black offset shadows for cards and figures; phases as adjoining pastel blocks in one bordered strip; the highlighted box turns yellow. No rounded corners, gradients or soft shadows.",
    "narrative": "Hook, what we deliver, features, numbers, principle, method, timeline, impact, team, call to action.",
    "nativeCoverage": "Cover box, boxed quote, feature cards, stat boxes, phase strip, bar chart and boxed closing as native shapes, text and chart. Tilted stat boxes, letter and initial badges, dot-grid and hatch ornaments, the black image half of the split page, buttons, and Space Grotesk / mono label type are not reproduced."
  },
  "pageMapping": [
    {
      "page": 1,
      "archetype": "cover",
      "native": "cover_slide",
      "status": "adapted",
      "differences": "The tag outline around the kicker and the 'get started' label text are omitted; the chip is drawn empty."
    },
    {
      "page": 2,
      "archetype": "cards",
      "native": "content_slide + card",
      "status": "approximate",
      "differences": "Source keeps the title, paragraph and two chips in a left column with three cards stacked on the right; native puts the title on top and the three cards in one row."
    },
    {
      "page": 3,
      "archetype": "cards",
      "native": "content_slide + card",
      "status": "adapted",
      "differences": "Letter badges and yellow corner squares on the cards are omitted; native adds a page title."
    },
    {
      "page": 4,
      "archetype": "chart-bar",
      "native": "content_slide + native_chart",
      "status": "approximate",
      "differences": "Source frames the chart in a white bordered box with three yellow stat chips beside it and outlines every bar; native draws the chart directly on the canvas."
    },
    {
      "page": 5,
      "archetype": "quote",
      "native": "statement_slide",
      "status": "adapted",
      "differences": "Hatched corner ornament is drawn as a plain green square."
    },
    {
      "page": 6,
      "archetype": "split-image",
      "native": "content_slide + bullets + image",
      "status": "approximate",
      "differences": "Source puts the image on a black left half and a numbered list with a button on the right; native keeps one canvas with text left and the image region right."
    },
    {
      "page": 7,
      "archetype": "process",
      "native": "content_slide + steps",
      "status": "adapted",
      "differences": ""
    },
    {
      "page": 8,
      "archetype": "stats",
      "native": "content_slide + kpi",
      "status": "adapted",
      "differences": "The slight tilt of each stat box and its corner dot are not reproduced."
    },
    {
      "page": 9,
      "archetype": "team",
      "native": "content_slide + card",
      "status": "approximate",
      "differences": "Source is a 2x3 grid with a coloured initials badge on each card; native is one row of cards without badges."
    },
    {
      "page": 10,
      "archetype": "closing",
      "native": "closing_slide",
      "status": "adapted",
      "differences": "The yellow button is omitted; contact text sits as a plain line in the box."
    }
  ]
