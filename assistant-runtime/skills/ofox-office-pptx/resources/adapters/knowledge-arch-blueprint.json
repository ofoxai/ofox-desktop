  "recipe": {
    "composition": "Warm paper canvas; a short rust rule and a heavy black sans title at the top left, body below on a strict grid, a hairline above the footer. The closing title is centred and oversized.",
    "components": "White rounded cards with a 1.5 pt ink outline; exactly one card, stat or step per page is filled rust with light text to mark the core. Dark code panel for manifests. Rust is never used for decoration.",
    "narrative": "Blueprint overview, why it matters, original versus upgraded, how it is implemented, system loop, results, next steps, thanks.",
    "nativeCoverage": "Cover, chapter, comparison, code panel, step row, stat boxes, process diagram and closing as native text, shapes and connectors. Not reproduced: two-colour titles with one rust keyword, mono kicker labels above content titles, dashed curved feedback arrows, the giant Playfair numeral, syntax colouring in code, Inter and JetBrains Mono."
  },
  "pageMapping": [
    {
      "page": 1,
      "archetype": "cover",
      "native": "cover_slide",
      "status": "approximate",
      "differences": "Source cover also carries a four-step pipeline card row and a rust key-insight card; native cover has the kicker, title and subtitle with a small four-box pipeline motif. The rust keyword inside the title is not coloured separately."
    },
    {
      "page": 2,
      "archetype": "chapter",
      "native": "section_slide",
      "status": "adapted",
      "differences": "The rust keyword inside the title is not coloured separately."
    },
    {
      "page": 3,
      "archetype": "comparison",
      "native": "content_slide + card",
      "status": "approximate",
      "differences": "Source upgraded card is a pale rust tint with a rust outline and a legend row below; native highlights it as a solid rust card and has no legend."
    },
    {
      "page": 4,
      "archetype": "code",
      "native": "content_slide + code",
      "status": "adapted",
      "differences": "Syntax colouring inside the code panel is not reproduced."
    },
    {
      "page": 5,
      "archetype": "cycle",
      "native": "content_slide + relation + callout",
      "status": "approximate",
      "differences": "Dashed curved feedback arrows with labels above and below the pipeline are not drawn; the loop is stated in a callout line under a straight process row."
    },
    {
      "page": 6,
      "archetype": "stats",
      "native": "content_slide + kpi",
      "status": "approximate",
      "differences": "Source sets one giant serif rust numeral beside four outlined fact cards; native is a row of three outlined stat boxes with rust mono numerals, the first with a rust outline."
    },
    {
      "page": 7,
      "archetype": "process",
      "native": "content_slide + steps",
      "status": "adapted",
      "differences": "Mono step labels become large step numerals."
    },
    {
      "page": 8,
      "archetype": "closing",
      "native": "closing_slide",
      "status": "adapted",
      "differences": "The rust dot between the two words and the mono kicker are not drawn."
    }
  ]
